        <mxCell id="eConflict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=4 4;strokeColor=#b91c1c;strokeWidth=2.5;endArrow=blockThin;endFill=1;startArrow=blockThin;startFill=1;exitX=1;exitY=0.25;entryX=0;entryY=0.5;" edge="1" parent="1" source="hub" target="cf">
          <mxGeometry relative="1" as="geometry">
