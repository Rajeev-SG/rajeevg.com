<mxCell id="note_ai_makes_extraction_and_retrie" value="AI makes extraction and retrieval cheap. It does not decide ownership, review dates, or which source wins — those stay human." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#fffde7;strokeColor=#fbc02d;fontSize=13;fontStyle=2;labelBackgroundColor=#fffde7;" vertex="1" parent="1"><mxGeometry x="790" y="570" width="650" height="44" as="geometry"/></mxCell>
