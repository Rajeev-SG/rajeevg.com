<mxCell id="n_local_services" value="&lt;b&gt;Local services&lt;/b&gt;&lt;br&gt;agents · collectors · ops boards — every listener bound to loopback only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="58" y="164" width="604" height="150" as="geometry"/></mxCell>
<mxCell id="n_coolify_stack" value="&lt;b&gt;Coolify stack&lt;/b&gt;&lt;br&gt;VictoriaMetrics · Grafana · isolated stacks with persistent volumes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="58" y="464" width="604" height="150" as="geometry"/></mxCell>
<mxCell id="n_your_devices" value="&lt;b&gt;Your devices&lt;/b&gt;&lt;br&gt;phone · laptop — reach boards and SSH from anywhere with tailnet credentials" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22c55e;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="738" y="164" width="344" height="150" as="geometry"/></mxCell>
<mxCell id="n_vercel" value="&lt;b&gt;Vercel&lt;/b&gt;&lt;br&gt;serves rajeevg.com — nothing self-hosted faces the internet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1158" y="164" width="264" height="150" as="geometry"/></mxCell>
<mxCell id="note_no_public_ports_no_firewall_ho" value="No public ports · no firewall holes · sleep pauses everything by design" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#fffde7;strokeColor=#fbc02d;fontSize=13;fontStyle=2;labelBackgroundColor=#fffde7;" vertex="1" parent="1"><mxGeometry x="720" y="560" width="700" height="44" as="geometry"/></mxCell>
<mxCell id="legend" value="Green = the only path in (Tailscale, with credentials)   ·   Purple = container isolation, state persisted in volumes   ·   Grey dashed = no path — the public edge cannot reach self-hosted services" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=13;labelBackgroundColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="40" y="648" width="1400" height="44" as="geometry"/></mxCell>
