<mxCell id="title" value="&lt;b&gt;The Mac's security boundary — what actually listens where&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=20;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;fontSize=19;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1400" height="56" as="geometry"/></mxCell>
<mxCell id="band_loop" value="&lt;b&gt;ZONE 1 · LOOPBACK — 127.0.0.1, unreachable from outside&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;fontSize=13;opacity=55;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="640" height="260" as="geometry"/></mxCell>
<mxCell id="band_cont" value="&lt;b&gt;ZONE 2 · CONTAINERS — OrbStack, volumes persist state&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=2;fontSize=13;opacity=55;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="640" height="240" as="geometry"/></mxCell>
<mxCell id="band_mesh" value="&lt;b&gt;ZONE 3 · PRIVATE MESH — Tailscale&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;fontSize=13;opacity=55;" vertex="1" parent="1"><mxGeometry x="720" y="120" width="380" height="540" as="geometry"/></mxCell>
<mxCell id="band_edge" value="&lt;b&gt;ZONE 4 · PUBLIC EDGE — the only exposure&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=12;spacingLeft=16;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;fontSize=13;opacity=55;" vertex="1" parent="1"><mxGeometry x="1140" y="120" width="300" height="540" as="geometry"/></mxCell>
