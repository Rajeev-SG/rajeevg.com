<mxfile host="opus-visual-remediation-72" agent="claude-opus-5" version="26.0.3">
  <diagram id="agenticanalytics" name="Agentic analytics verification loop">
    <mxGraphModel dx="1700" dy="1050" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="930" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="eRef" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=8 6;strokeColor=#1d4ed8;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="contract" target="qa">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="30" y="225" />
              <mxPoint x="30" y="655" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="eCfg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7c3aed;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="cfg" target="qa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eFir" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#be123c;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="fir" target="qa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eBuild" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7c3aed;strokeWidth=2.5;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="cfg" target="fir">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eOut" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#15803d;strokeWidth=3;endArrow=blockThin;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="qa" target="rep">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eGap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;dashPattern=8 6;strokeColor=#b45309;strokeWidth=3;endArrow=blockThin;endFill=1;exitX=1;exitY=0.2;entryX=0.5;entryY=0;" edge="1" parent="1" source="qa" target="cfg">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="930" y="604" />
              <mxPoint x="930" y="314" />
              <mxPoint x="250" y="314" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="title" value="&lt;b style=&quot;font-size:23px&quot;&gt;A tag that exists is not a tag that fired&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#cbd5e1&quot;&gt;The contract says what should happen. The browser says what did. The verify step is the only place those two are compared.&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;align=left;spacingLeft=22;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1280" height="84" as="geometry" />
        </mxCell>

        <mxCell id="hPlan" value="&lt;b&gt;PLAN &amp;mdash; AGREED BEFORE ANYTHING IS BUILT&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#1d4ed8;" vertex="1" parent="1">
          <mxGeometry x="60" y="140" width="600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="contract" value="&lt;b style=&quot;font-size:19px&quot;&gt;Measurement contract&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;events &amp;middot; properties &amp;middot; owners &amp;middot; the consent model &amp;mdash; written down and agreed&lt;br&gt;before a single tag exists. Everything below is judged against this, not against itself.&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=3;align=left;spacingLeft=18;verticalAlign=middle;fontColor=#1e3a8a;" vertex="1" parent="1">
          <mxGeometry x="60" y="170" width="800" height="110" as="geometry" />
        </mxCell>
        <mxCell id="gate1" value="&lt;b style=&quot;font-size:15px&quot;&gt;HUMAN GATE 1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;a person signs the contract off.&lt;br&gt;The agent never edits it to match&lt;br&gt;what it happened to build.&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;dashed=1;dashPattern=8 6;align=left;spacingLeft=16;verticalAlign=middle;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="900" y="170" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="hCfg" value="&lt;b&gt;WHAT WAS CONFIGURED&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#7c3aed;" vertex="1" parent="1">
          <mxGeometry x="60" y="326" width="380" height="24" as="geometry" />
        </mxCell>
        <mxCell id="hFir" value="&lt;b&gt;WHAT ACTUALLY FIRED&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#be123c;" vertex="1" parent="1">
          <mxGeometry x="480" y="326" width="380" height="24" as="geometry" />
        </mxCell>
        <mxCell id="cfg" value="&lt;b style=&quot;font-size:17px&quot;&gt;GTM workspace&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;tags &amp;middot; triggers &amp;middot; variables&lt;br&gt;versioned and reviewed&lt;br&gt;before publish&lt;br&gt;&lt;br&gt;&lt;i&gt;built by the agent, against&lt;br&gt;the contract above&lt;/i&gt;&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=2.5;align=left;spacingLeft=16;verticalAlign=middle;fontColor=#4c1d95;" vertex="1" parent="1">
          <mxGeometry x="60" y="354" width="380" height="166" as="geometry" />
        </mxCell>
        <mxCell id="fir" value="&lt;b style=&quot;font-size:17px&quot;&gt;GA4 property&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;events stream in &amp;mdash; but what&lt;br&gt;fires depends on consent,&lt;br&gt;not on configuration&lt;br&gt;&lt;br&gt;&lt;i&gt;this is the side nobody&lt;br&gt;checks by default&lt;/i&gt;&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=2.5;align=left;spacingLeft=16;verticalAlign=middle;fontColor=#9f1239;" vertex="1" parent="1">
          <mxGeometry x="480" y="354" width="380" height="166" as="geometry" />
        </mxCell>

        <mxCell id="hQA" value="&lt;b&gt;VERIFY &amp;mdash; HUMAN GATE 2&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#0f766e;" vertex="1" parent="1">
          <mxGeometry x="60" y="546" width="600" height="24" as="geometry" />
        </mxCell>
        <mxCell id="qa" value="&lt;b style=&quot;font-size:19px&quot;&gt;QA harness &amp;mdash; the diff&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px&quot;&gt;real browser journeys through the consent path &amp;middot; observed events compared&lt;br&gt;against the contract &amp;middot; the configured-versus-firing gap measured, not assumed&lt;br&gt;&lt;br&gt;&lt;b&gt;A person accepts or rejects the gap. Nothing ships on a gap nobody has read.&lt;/b&gt;&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f0fdfa;strokeColor=#0f766e;strokeWidth=3;align=left;spacingLeft=18;verticalAlign=middle;fontColor=#134e4a;" vertex="1" parent="1">
          <mxGeometry x="60" y="574" width="800" height="150" as="geometry" />
        </mxCell>

        <mxCell id="note" value="&lt;b style=&quot;font-size:15px;color:#9f1239&quot;&gt;The failure this exists to catch&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#9f1239&quot;&gt;A tag that exists but is silently&lt;br&gt;blocked by consent under-counts&lt;br&gt;with no error, no warning and no&lt;br&gt;signal anywhere in the interface.&lt;br&gt;Only a real browser run finds it.&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fff1f2;strokeColor=#be123c;strokeWidth=2;dashed=1;dashPattern=4 4;align=left;spacingLeft=16;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="354" width="340" height="166" as="geometry" />
        </mxCell>

        <mxCell id="hRep" value="&lt;b&gt;USE &amp;mdash; ONLY AFTER THE DIFF IS READ&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#15803d;" vertex="1" parent="1">
          <mxGeometry x="1000" y="546" width="340" height="24" as="geometry" />
        </mxCell>
        <mxCell id="rep" value="&lt;b style=&quot;font-size:17px&quot;&gt;Reporting&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;GA4 &amp;middot; BigQuery &amp;middot; vendor data&lt;br&gt;reconciled before anything&lt;br&gt;reaches a decision&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=3;align=left;spacingLeft=16;verticalAlign=middle;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="1000" y="574" width="340" height="150" as="geometry" />
        </mxCell>

        <mxCell id="annGap" value="&lt;span style=&quot;font-size:14px;color:#b45309&quot;&gt;&lt;b&gt;gap found&lt;/b&gt; &amp;mdash; the fix goes back into the workspace, never into the contract&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="290" y="288" width="620" height="24" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;span style=&quot;font-size:15px&quot;&gt;&lt;b style=&quot;color:#1d4ed8&quot;&gt;Blue&lt;/b&gt; = the plan, agreed first and never edited to fit the build. &amp;nbsp; &lt;b style=&quot;color:#7c3aed&quot;&gt;Purple&lt;/b&gt; = what was configured. &amp;nbsp; &lt;b style=&quot;color:#be123c&quot;&gt;Red&lt;/b&gt; = what actually fired. &amp;nbsp; &lt;b style=&quot;color:#0f766e&quot;&gt;Teal&lt;/b&gt; = the diff, run in a real browser. &amp;nbsp; &lt;b style=&quot;color:#b45309&quot;&gt;Dashed amber&lt;/b&gt; = a person&amp;rsquo;s decision, and the return path a rejected gap takes. &amp;nbsp; &lt;b style=&quot;color:#15803d&quot;&gt;Green&lt;/b&gt; = trusted enough to report.&lt;br&gt;Evidence date: 31 August 2026.&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=18;verticalAlign=middle;fontColor=#334155;" vertex="1" parent="1">
          <mxGeometry x="60" y="756" width="1280" height="78" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
