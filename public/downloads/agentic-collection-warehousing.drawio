<mxCell id="note_the_decision_variable_is_not_v" value="The decision variable is not volume — it is whether you need first-party cookie control and event transformation." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#fffde7;strokeColor=#fbc02d;fontSize=13;fontStyle=2;labelBackgroundColor=#fffde7;" vertex="1" parent="1"><mxGeometry x="360" y="700" width="1040" height="44" as="geometry"/></mxCell>
<mxCell id="legend" value="Blue = consented collection either way   ·   Orange = the heavy path: only when first-party control is a requirement   ·   Green = the light path: usually the right answer   ·   Purple = reconciliation, the point of it all" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=13;labelBackgroundColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="40" y="728" width="1400" height="44" as="geometry"/></mxCell>
