        <mxCell id="p-logic-setup-3-desc" parent="p-logic-layer-annotations" value="The same base tag and shared event configuration can be used across participating market websites." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#607089;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;pointerEvents=0;" vertex="1" connectable="0">
