        <mxCell id="p-misconfiguredUk-scenario-lede" parent="p-misconfiguredUk-scenario-content" value="Cross-account conversion tracking is an account setting, not just a tag deployment. A child that continues using 'This account' is outside the manager-owned conversion setup." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#607089;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;pointerEvents=0;" vertex="1" connectable="0">
