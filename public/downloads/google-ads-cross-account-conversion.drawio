        <mxCell id="p-frClickUk-scenario-title" parent="p-frClickUk-scenario-content" value="French ad click, conversion on the UK site" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=22;fontColor=#142033;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;pointerEvents=0;" vertex="1" connectable="0">
