        <mxCell id="p-misconfiguredUk-scenario-rule" parent="p-misconfiguredUk-scenario-content" value="The shared manager actions only govern child accounts configured to use that manager as their conversion account." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#142033;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;pointerEvents=0;" vertex="1" connectable="0">
