        <mxCell id="p-logic-setup-4-desc" parent="p-logic-layer-annotations" value="Keep auto-tagging on, allow the GCLID or equivalent click information to survive redirects, and configure cross-domain linking where journeys cross domains." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=10;fontColor=#607089;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;pointerEvents=0;" vertex="1" connectable="0">
