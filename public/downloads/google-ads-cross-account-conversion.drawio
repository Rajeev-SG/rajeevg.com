        <mxCell id="p-frClickUk-scenario-rule-label" parent="p-frClickUk-scenario-content" value="WHY THE CREDIT GOES THERE" style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=10;fontColor=#1558B0;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;pointerEvents=0;" vertex="1" connectable="0">
