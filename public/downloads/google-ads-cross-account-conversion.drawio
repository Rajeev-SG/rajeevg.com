        <mxCell id="p-frClickUk-scenario-lede" parent="p-frClickUk-scenario-content" value="This cross-market example proves that the website country is not the router. Provided the click information survives, the French serving account can receive credit for a conversion on the UK site." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#607089;fontStyle=0;spacing=0;strokeColor=none;fillColor=none;pointerEvents=0;" vertex="1" connectable="0">
