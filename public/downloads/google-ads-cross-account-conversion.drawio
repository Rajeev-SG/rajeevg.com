        </mxCell>
        <mxCell id="p-frClickUk-scenario-rule" parent="p-frClickUk-scenario-content" value="The French click determines the serving account; the UK domain only identifies where the conversion happened." style="text;html=1;whiteSpace=wrap;overflow=hidden;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;fontColor=#142033;fontStyle=1;spacing=0;strokeColor=none;fillColor=none;pointerEvents=0;" vertex="1" connectable="0">
