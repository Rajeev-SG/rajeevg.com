<mxfile host="opus-visual-remediation-72" agent="claude-opus-5" version="26.0.3">
  <diagram id="telemetryref" name="Agent telemetry reference architecture">
    <mxGraphModel dx="1800" dy="1200" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="990" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="z1" value="" style="rounded=1;html=1;fillColor=#eff6ff;strokeColor=#93c5fd;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="300" height="320" as="geometry" />
