        <mxCell id="overall_verdict" value="&lt;b&gt;Does it work?&lt;/b&gt; Mostly, with fail-closed gaps.&lt;br&gt;&lt;b&gt;Is it all observable?&lt;/b&gt; No.&lt;br&gt;&lt;font color=&quot;#991b1b&quot;&gt;Unproven: complete live join · clean concurrent attribution&lt;br&gt;takeover/reset/return cycle · whole-task savings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=3;fontSize=15;labelBackgroundColor=#fee2e2;" vertex="1" parent="1"><mxGeometry x="1230" y="1050" width="410" height="140" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;STATUS&lt;/b&gt;  &lt;font color=&quot;#166534&quot;&gt;■ PROVEN&lt;/font&gt;  deterministic or direct evidence   ·   &lt;font color=&quot;#92400e&quot;&gt;■ PARTIAL&lt;/font&gt;  seam works but end-to-end proof is incomplete   ·   &lt;font color=&quot;#991b1b&quot;&gt;■ UNPROVEN / OPEN&lt;/font&gt;  do not infer success   ·   Blue = primary path   ·   Orange dashed = capacity/modal route   ·   Purple = telemetry" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=13;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="80" y="1210" width="1560" height="40" as="geometry"/></mxCell>
