<mxCell id="codex" value="&lt;b&gt;Fresh Codex task&lt;/b&gt;&lt;br&gt;Owns intent, boundaries&lt;br&gt;and final review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=2;fontSize=14;labelBackgroundColor=#dbeafe;" vertex="1" parent="1"><mxGeometry x="80" y="190" width="220" height="100" as="geometry"/></mxCell><mxCell id="pack" value="&lt;b&gt;Durable packet&lt;/b&gt;&lt;br&gt;Manifest + exact next action&lt;br&gt;Beads / BVR state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=14;labelBackgroundColor=#dcfce7;" vertex="1" parent="1"><mxGeometry x="350" y="190" width="220" height="100" as="geometry"/></mxCell><mxCell id="mail" value="&lt;b&gt;Agent Mail + NTM&lt;/b&gt;&lt;br&gt;Acknowledge, reserve&lt;br&gt;and schedule" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;strokeWidth=2;fontSize=14;labelBackgroundColor=#ede9fe;" vertex="1" parent="1"><mxGeometry x="620" y="190" width="220" height="100" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;OpenCode Go / Luna&lt;/b&gt;&lt;br&gt;Bounded execution&lt;br&gt;default worker route" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;strokeWidth=2;fontSize=14;labelBackgroundColor=#dcfce7;" vertex="1" parent="1"><mxGeometry x="890" y="190" width="220" height="100" as="geometry"/></mxCell><mxCell id="proof" value="&lt;b&gt;Telemetry + verification&lt;/b&gt;&lt;br&gt;Scope, usage, tests&lt;br&gt;and browser evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=2;fontSize=14;labelBackgroundColor=#fef3c7;" vertex="1" parent="1"><mxGeometry x="1160" y="190" width="220" height="100" as="geometry"/></mxCell><mxCell id="deepseek" value="&lt;b&gt;DeepSeek&lt;/b&gt;&lt;br&gt;Health-gated text&lt;br&gt;capacity fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;strokeWidth=2;fontSize=14;