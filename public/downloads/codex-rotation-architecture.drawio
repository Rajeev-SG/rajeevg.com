        <mxCell id="band_control" value="&lt;b&gt;1 · DESKTOP CONTEXT ROTATION&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;Changes the Codex parent context. This is not a worker-provider fallback.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontSize=15;labelBackgroundColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1720" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="band_worker" value="&lt;b&gt;2 · AUTHORITATIVE DELEGATION + RETURN&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;One immutable packet, one bounded worker, compact evidence, then native parent review.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=2;fontSize=15;labelBackgroundColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="1720" height="290" as="geometry"/>
        </mxCell>
        <mxCell id="band_fallback" value="&lt;b&gt;3 · CAPACITY FALLBACK + MODAL ROUTING&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot;&gt;OpenRouter is capacity-only for text. Qwen is an image-bearing route, never a text fallback.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=14;spacingLeft=18;fillColor=#fffaf0;strokeColor=#f59e0b;strokeWidth=2;fontSize=15;labelBackgroundColor=#fffaf0;" vertex="1" parent="1">
          <mxGeometry x="40" y="700" width="1720" height="240" as="geometry"/>
        </mxCell>
