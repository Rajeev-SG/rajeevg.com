<mxfile host="app.diagrams.net">
  <diagram id="agentops-loop" name="Agent Ops operating loop">
    <mxGraphModel dx="1000" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="laneA" value="Day / every run" style="swimlane;horizontal=0;startSize=100;fillColor=#f5f7fa;strokeColor=#94a3b8;html=1;fontSize=13;fontStyle=1;swimlaneFillColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="1120" height="230" as="geometry" />
        </mxCell>
        <mxCell id="laneB" value="Anything drifts" style="swimlane;horizontal=0;startSize=100;fillColor=#f8fafc;strokeColor=#94a3b8;html=1;fontSize=13;fontStyle=1;swimlaneFillColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="1120" height="230" as="geometry" />
        </mxCell>
        <mxCell id="laneC" value="After the fix" style="swimlane;horizontal=0;startSize=100;fillColor=#f1f5f9;strokeColor=#94a3b8;html=1;fontSize=13;fontStyle=1;swimlaneFillColor=none;" vertex="1" parent="1">
          <mxGeometry x="20" y="560" width="1120" height="260" as="geometry" />
        </mxCell>
        <mxCell id="worktree" value="Pick up the next task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="80" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="contract" value="Write the contract + acceptance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="80" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="session" value="One session, bounded context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="80" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tools" value="Scoped tool + sandbox grants" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="960" y="80" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="telemetry" value="Telemetry: sessions, tokens, cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="170" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="check" value="Acceptance proof vs contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="170" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="merge" value="Land it or throw the worktree away" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="960" y="170" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="drift" value="Drift: alerts fire, contract missed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="350" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="page" value="One human alert channel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="350" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="runbook" value="One runbook per known failure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="350" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fix" value="Fix the cause, not this run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="960" y="350" width="150" height="70" as="geometry" />
        </mxCell>
        <mxCell id="review" value="Review loop: contract / routing / perms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#e11d48;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="140" y="610" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="budget" value="Update budget + routing rules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#e11d48;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="430" y="610" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="runbooks" value="Write the next runbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#e11d48;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="720" y="610" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="keeper" value="Keeper restarts what died only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#64748b;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="960" y="610" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="worktree" target="contract">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="contract" target="session">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="session" target="tools">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="tools" target="check">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1130" y="115" />
              <mxPoint x="1130" y="255" />
              <mxPoint x="700" y="255" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="check" target="merge">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;dashed=1;" edge="1" parent="1" source="session" target="telemetry">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="150" />
              <mxPoint x="680" y="150" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;dashed=1;" edge="1" parent="1" source="telemetry" target="budget">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="400" y="255" />
              <mxPoint x="400" y="630" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="drift" target="page">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="page" target="runbook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="runbook" target="fix">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#e11d48;strokeWidth=2;" edge="1" parent="1" source="fix" target="review">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1035" y="440" />
              <mxPoint x="70" y="440" />
              <mxPoint x="70" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="merge" target="keeper">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1140" y="205" />
              <mxPoint x="1140" y="650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#e11d48;strokeWidth=2;" edge="1" parent="1" source="keeper" target="worktree">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1035" y="770" />
              <mxPoint x="95" y="770" />
              <mxPoint x="95" y="150" />
