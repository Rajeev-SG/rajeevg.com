        <mxCell id="legend" value="Gray: work + telemetry. Red: incident and learning loop." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cbd5e1;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="140" y="780" width="300" height="70" as="geometry" />
