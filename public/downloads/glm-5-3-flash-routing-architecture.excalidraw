    {
      "id": "foot",
      "type": "text",
      "x": 110,
      "y": 776,
      "width": 1000,
      "height": 46,
      "angle": 0,
      "autoResize": true,
      "backgroundColor": "transparent",
      "boundElements": null,
      "containerId": null,
      "fillStyle": "solid",
      "fontFamily": 5,
      "fontSize": 15,
      "frameId": null,
      "groupIds": [],
      "index": "a45",
      "isDeleted": false,
      "lineHeight": 1.25,
      "link": null,
      "locked": false,
      "opacity": 100,
      "originalText": "Grey dashes = the hop stamps the key.  ·  Teal dashes = the record carries the key.  ·  Solid teal = it becomes a comparable benchmark row.\nThe two views are never joined by wall-clock time, which is why identical tasks stay comparable across routing modes.",
      "roughness": 1,
      "roundness": null,
      "seed": 1362886521,
      "strokeColor": "#64748b",
      "strokeStyle": "solid",
      "strokeWidth": 2,
      "text": "Grey dashes = the hop stamps the key.  ·  Teal dashes = the record carries the key.  ·  Solid teal = it becomes a comparable benchmark row.\nThe two views are never joined by wall-clock time, which is why identical tasks stay comparable across routing modes.",
      "textAlign": "left",
      "updated": 1788276439227,
      "version": 1,
      "versionNonce": 706848727,
      "verticalAlign": "top"
    }
  ],
