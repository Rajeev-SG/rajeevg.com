<mxCell id="n_launchd" value="&lt;b&gt;launchd&lt;/b&gt;&lt;br&gt;one job per agent · starts and restarts · defines what running means" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="58" y="164" width="284" height="150" as="geometry"/></mxCell>
<mxCell id="n_semaphore_ops_board" value="&lt;b&gt;Semaphore ops board&lt;/b&gt;&lt;br&gt;state of every service · what changed and when" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="418" y="164" width="284" height="150" as="geometry"/></mxCell>
<mxCell id="n_alertmanager" value="&lt;b&gt;Alertmanager&lt;/b&gt;&lt;br&gt;watches metrics · routes alarms to Telegram · silence when handled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f59e0b;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="778" y="164" width="284" height="150" as="geometry"/></mxCell>
<mxCell id="n_runbook" value="&lt;b&gt;Runbook&lt;/b&gt;&lt;br&gt;one document per failure mode · the exact SOP linked from the alarm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;align=center;" vertex="1" parent="1"><mxGeometry x="1138" y="164" width="284" height="150" as="geometry"/></mxCell>
<mxCell id="note_grafana_provides_the_context_b" value="Grafana provides the context behind each alarm · Telegram is the remote desk" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#fffde7;strokeColor=#fbc02d;fontSize=13;fontStyle=2;labelBackgroundColor=#fffde7;" vertex="1" parent="1"><mxGeometry x="400" y="480" width="1040" height="44" as="geometry"/></mxCell>
<mxCell id="legend" value="Solid = the state flows left to right   ·   Green dashed = the runbook fix closes the loop at launchd   ·   The loop ends when the cause is fixed, not the symptom" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=14;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=13;labelBackgroundColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="40" y="568" width="1400" height="44" as="geometry"/></mxCell>
