        <mxCell id="g1" value="&lt;b style=&quot;font-size:16px&quot;&gt;Human gate 1 &amp;middot; Scope&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;agree the events, properties,&lt;br&gt;owners and consent model&lt;br&gt;before anything is built&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;dashed=1;dashPattern=8 6;align=left;spacingLeft=16;verticalAlign=middle;fontColor=#7c2d12;" vertex="1" parent="1">
          <mxGeometry x="600" y="284" width="320" height="112" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="&lt;b style=&quot;font-size:16px&quot;&gt;Human gate 2 &amp;middot; Reconcile&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;accept or reject the gap between&lt;br&gt;what was configured and what fired&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#fffbeb;strokeColor=#b45309;strokeWidth=2;dashed=1;dashPattern=8 6;align=left;spacingLeft=16;verticalAlign=middle;fontColor=#7c2d12;" vertex="1" parent="1">
