          <mxGeometry x="950" y="650" width="300" height="64" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="&lt;span style=&quot;font-size:15px&quot;&gt;&lt;b style=&quot;color:#3730a3&quot;&gt;Solid indigo&lt;/b&gt; = the machine path, run without a person. &amp;nbsp; &lt;b style=&quot;color:#b45309&quot;&gt;Dashed amber&lt;/b&gt; = the only three places a person must decide. &amp;nbsp; &lt;b style=&quot;color:#be123c&quot;&gt;Dashed rose&lt;/b&gt; = the failure that step exists to catch.&lt;br&gt;The amber rail down the left is the return path: QA failures and reconciliation gaps go back to the contract, never to a workaround. &amp;nbsp; Evidence date: 31 August 2026.&lt;/span&gt;" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;spacingLeft=18;verticalAlign=middle;fontColor=#334155;" vertex="1" parent="1">
