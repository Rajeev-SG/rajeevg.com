{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept, RSC, Next-Router-State-Tree, Next-Router-Prefetch, Next-Router-Segment-Prefetch"
        }
      ]
    },
    {
      "source": "/interfaces/(.*)",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "manual-preview": true,
      "*": false,
      "**": false,
      "pareto-data": false,
      "benchmark-data": false
    }
  }
}
